<?xml version="1.0" encoding="UTF-8" ?>
<!-- No copyright or license for configuration file, details here are not considered a creative work. -->
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">

    <!-- The settings of the component, each overridden from the environment by its path: genicam@images-path is
         moqui_conf__genicam__images_path (`moqui conf env`). A service reads one as ec.factory.getConfValue("genicam@...").
         live-refresh-ms: the live view (screen GenicamLive.xml) asks for a new frame this often; process-timeout-ms: the
         longest wait for one answer of a camera's Python worker, which is then stopped and its command not sent again. -->
    <genicam images-path="runtime/genicam/images" frames-path="runtime/genicam/frames" videos-path="runtime/genicam/videos"
            servo-path="runtime/genicam/servo" tensors-path="runtime/genicam/tensors" image-format="jpg"
            video-container="avi" video-codec="MJPG" frames-default-num-frames="10"
            videos-default-num-frames="60" videos-default-fps="15.0" connection-retry-count="3"
            connection-retry-backoff-ms="1000" connection-fetch-timeout-ms="1000" multi-process-timeout-ms="120000"
            process-timeout-ms="120000" live-refresh-ms="500" stream-stop-timeout-ms="3000"
            stream-mock-frame-delay-ms="100" servo-default-use-cached-frame="true" servo-default-save-snapshot="false"
            servo-buffer-source="latest" servo-max-frame-age-ms="250" images-resize-width=""
            images-resize-height="" frames-resize-width="" frames-resize-height=""
            videos-resize-width="" videos-resize-height="" servo-resize-width=""
            servo-resize-height=""/>

    <screen-facade>
        <screen location="component://webroot/screen/webroot.xml">
            <subscreens-item name="genicam" menu-include="false" location="component://moqui-genicam/screen/GenicamLive.xml"/>
        </screen>
    </screen-facade>

    <tools>
        <tool-factory class="moqui_genicam::GenicamClientFactory" init-priority="25"/>
        <tool-factory class="moqui_genicam::GenicamMultiCameraRunnerFactory" init-priority="25"/>
    </tools>
</moqui-conf>
