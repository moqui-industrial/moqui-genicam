<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- The services of the Java version, with the same names and parameters. Their XML Actions find the camera and its
         DeviceConnection; the work of their Groovy scripts is the JavaScript library Genicam.js, and the camera is the
         Rust tool GenicamClient (src/client.rs), which runs script/genicam_bridge.py in a Python worker process. -->

    <!-- ========== GenICam Request Services ========== -->

    <service verb="run" noun="GenICamRequest" authenticate="false" transaction="ignore">
        <description>Implements the run#DeviceRequestInternal interface for GenICam vision cameras: DrtRead reads the
            GenICam nodes named in DeviceRequestItem.query, DrtWrite writes the values of the items' Parameters to
            them. The values the camera answers are stored with DeviceAcquisitionServices.store#Samples (current
            Parameter values, ParameterLog for a DrpLogging request). A camera failure sets the Device to
            DbsErrorStop.</description>
        <implements service="moqui.device.DeviceServices.run#DeviceRequestInternal"/>
        <out-parameters>
            <parameter name="status"/>
            <parameter name="samples" type="List"/>
            <parameter name="storedCount" type="Long"/>
        </out-parameters>
        <actions>
            <set field="genicam" from="ec.resource.script('component://moqui-genicam/service/moqui/genicam/Genicam.js')"/>
            <set field="answer" from="genicam.execute('runRequest', context)"/>
            <set field="status" from="answer.status"/>
            <set field="samples" from="answer.samples"/>
            <set field="storedCount" from="answer.storedCount"/>
        </actions>
    </service>

    <!-- ========== Acquisition Services ========== -->

    <service verb="acquire" noun="SingleImage" authenticate="false" transaction="ignore">
        <description>Captures one frame and saves it as a jpg, png or bmp file, registered as a DeviceContent of the camera.</description>
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="connectionName"/>
            <parameter name="outputDir"/>
            <parameter name="imageFormat"/>
            <parameter name="resizeWidth" type="Integer"/>
            <parameter name="resizeHeight" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="imageLocation"/>
            <parameter name="imageFormat"/>
            <parameter name="contentType"/>
            <parameter name="width" type="Integer"/>
            <parameter name="height" type="Integer"/>
            <parameter name="deviceContentId"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.Device" value-field="device"/>
            <if condition="!device"><return error="true" message="Device not found with ID: ${deviceId}"/></if>
            <if condition="connectionName">
                <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection">
                    <field-map field-name="connectionName"/>
                </entity-find-one>
                <else>
                    <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection">
                        <field-map field-name="deviceId"/>
                    </entity-find-one>
                </else>
            </if>
            <if condition="!connection"><return error="true" message="Connection not found for device: ${deviceId}"/></if>
            <if condition="!connection.transportConfig">
                <return error="true" message="Connection transportConfig must specify driver path."/>
            </if>
            <set field="genicam" from="ec.resource.script('component://moqui-genicam/service/moqui/genicam/Genicam.js')"/>
            <set field="answer" from="genicam.execute('singleImage', context)"/>
            <set field="imageLocation" from="answer.imageLocation"/>
            <set field="imageFormat" from="answer.imageFormat"/>
            <set field="contentType" from="answer.contentType"/>
            <set field="width" from="answer.width"/>
            <set field="height" from="answer.height"/>
            <set field="deviceContentId" from="answer.deviceContentId"/>
        </actions>
    </service>

    <service verb="acquire" noun="VideoStream" authenticate="false" transaction="ignore">
        <description>Captures numFrames frames as image files, each registered as a DeviceContent of the camera.</description>
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="connectionName"/>
            <parameter name="numFrames" type="Integer"/>
            <parameter name="outputDir"/>
            <parameter name="imageFormat"/>
            <parameter name="resizeWidth" type="Integer"/>
            <parameter name="resizeHeight" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="acquiredFrames" type="List"/>
            <parameter name="deviceContentIdList" type="List"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.Device" value-field="device"/>
            <if condition="!device"><return error="true" message="Device not found with ID: ${deviceId}"/></if>
            <if condition="connectionName">
                <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection">
                    <field-map field-name="connectionName"/>
                </entity-find-one>
                <else>
                    <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection">
                        <field-map field-name="deviceId"/>
                    </entity-find-one>
                </else>
            </if>
            <if condition="!connection"><return error="true" message="Connection not found for device: ${deviceId}"/></if>
            <if condition="!connection.transportConfig">
                <return error="true" message="Connection transportConfig must specify driver path."/>
            </if>
            <set field="genicam" from="ec.resource.script('component://moqui-genicam/service/moqui/genicam/Genicam.js')"/>
            <set field="answer" from="genicam.execute('videoStream', context)"/>
            <set field="acquiredFrames" from="answer.acquiredFrames"/>
            <set field="deviceContentIdList" from="answer.deviceContentIdList"/>
        </actions>
    </service>

    <service verb="acquire" noun="VideoFile" authenticate="false" transaction="ignore">
        <description>Records numFrames frames at fps into an avi or mp4 video file.</description>
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="connectionName"/>
            <parameter name="numFrames" type="Integer"/>
            <parameter name="fps" type="BigDecimal"/>
            <parameter name="outputDir"/>
            <parameter name="videoContainer"/>
            <parameter name="videoCodec"/>
            <parameter name="resizeWidth" type="Integer"/>
            <parameter name="resizeHeight" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="videoLocation"/>
            <parameter name="acquiredFrames" type="Integer"/>
            <parameter name="fps" type="BigDecimal"/>
            <parameter name="videoContainer"/>
            <parameter name="videoCodec"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.Device" value-field="device"/>
            <if condition="!device"><return error="true" message="Device not found with ID: ${deviceId}"/></if>
            <if condition="connectionName">
                <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection">
                    <field-map field-name="connectionName"/>
                </entity-find-one>
                <else>
                    <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection">
                        <field-map field-name="deviceId"/>
                    </entity-find-one>
                </else>
            </if>
            <if condition="!connection"><return error="true" message="Connection not found for device: ${deviceId}"/></if>
            <if condition="!connection.transportConfig">
                <return error="true" message="Connection transportConfig must specify driver path."/>
            </if>
            <set field="genicam" from="ec.resource.script('component://moqui-genicam/service/moqui/genicam/Genicam.js')"/>
            <set field="answer" from="genicam.execute('videoFile', context)"/>
            <set field="videoLocation" from="answer.videoLocation"/>
            <set field="acquiredFrames" from="answer.acquiredFrames"/>
            <set field="fps" from="answer.fps"/>
            <set field="videoContainer" from="answer.videoContainer"/>
            <set field="videoCodec" from="answer.videoCodec"/>
        </actions>
    </service>

    <service verb="acquire" noun="MultiVideoFile" authenticate="false" transaction="ignore">
        <description>Records a video file on each camera of deviceIdList at the same time, each camera in a Python
            process of its own (tool GenicamMultiCameraRunner, script/multi_camera_capture.py). connectionNameList
            names the connection of the camera at the same index; a camera without one uses its own.</description>
        <in-parameters>
            <parameter name="deviceIdList" type="List" required="true"/>
            <parameter name="connectionNameList" type="List"/>
            <parameter name="numFrames" type="Integer"/>
            <parameter name="fps" type="BigDecimal"/>
            <parameter name="outputDir"/>
            <parameter name="videoContainer"/>
            <parameter name="videoCodec"/>
            <parameter name="resizeWidth" type="Integer"/>
            <parameter name="resizeHeight" type="Integer"/>
            <parameter name="processTimeoutMs" type="Long"/>
        </in-parameters>
        <out-parameters>
            <parameter name="captureResults" type="List"/>
            <parameter name="successfulCount" type="Integer"/>
            <parameter name="failedCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="genicam" from="ec.resource.script('component://moqui-genicam/service/moqui/genicam/Genicam.js')"/>
            <set field="answer" from="genicam.execute('multiVideoFile', context)"/>
            <set field="captureResults" from="answer.captureResults"/>
            <set field="successfulCount" from="answer.successfulCount"/>
            <set field="failedCount" from="answer.failedCount"/>
        </actions>
    </service>

    <service verb="acquire" noun="VisualServoFrame" authenticate="false" transaction="ignore">
        <description>One frame for a visual servoing loop: the latest frame of the camera's streaming thread
            (useCachedFrame), else a new capture, with its bytes, format and capture time (capturedAt, Unix seconds).
            saveSnapshot also writes it as an image file, registered as a DeviceContent.</description>
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="connectionName"/>
            <parameter name="useCachedFrame" type="Boolean"/>
            <parameter name="saveSnapshot" type="Boolean"/>
            <parameter name="outputDir"/>
            <parameter name="imageFormat"/>
            <parameter name="resizeWidth" type="Integer"/>
            <parameter name="resizeHeight" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="frameBytes"/>
            <parameter name="jpegBytes"/>
            <parameter name="contentType"/>
            <parameter name="dataFormat"/>
            <parameter name="frameFormat"/>
            <parameter name="componentIndex" type="Integer"/>
            <parameter name="width" type="Integer"/>
            <parameter name="height" type="Integer"/>
            <parameter name="capturedAt"/>
            <parameter name="source"/>
            <parameter name="snapshotLocation"/>
            <parameter name="previewLocation"/>
            <parameter name="snapshotDeviceContentId"/>
            <parameter name="previewDeviceContentId"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.Device" value-field="device"/>
            <if condition="!device"><return error="true" message="Device not found with ID: ${deviceId}"/></if>
            <if condition="connectionName">
                <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection">
                    <field-map field-name="connectionName"/>
                </entity-find-one>
                <else>
                    <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection">
                        <field-map field-name="deviceId"/>
                    </entity-find-one>
                </else>
            </if>
            <if condition="!connection"><return error="true" message="Connection not found for device: ${deviceId}"/></if>
            <if condition="!connection.transportConfig">
                <return error="true" message="Connection transportConfig must specify driver path."/>
            </if>
            <set field="genicam" from="ec.resource.script('component://moqui-genicam/service/moqui/genicam/Genicam.js')"/>
            <set field="answer" from="genicam.execute('visualServoFrame', context)"/>
            <set field="frameBytes" from="answer.frameBytes"/>
            <set field="jpegBytes" from="answer.jpegBytes"/>
            <set field="contentType" from="answer.contentType"/>
            <set field="dataFormat" from="answer.dataFormat"/>
            <set field="frameFormat" from="answer.frameFormat"/>
            <set field="componentIndex" from="answer.componentIndex"/>
            <set field="width" from="answer.width"/>
            <set field="height" from="answer.height"/>
            <set field="capturedAt" from="answer.capturedAt"/>
            <set field="source" from="answer.source"/>
            <set field="snapshotLocation" from="answer.snapshotLocation"/>
            <set field="previewLocation" from="answer.previewLocation"/>
            <set field="snapshotDeviceContentId" from="answer.snapshotDeviceContentId"/>
            <set field="previewDeviceContentId" from="answer.previewDeviceContentId"/>
        </actions>
    </service>

    <service verb="stream" noun="LiveMjpeg" transaction="ignore">
        <description>The camera as a multipart/x-mixed-replace response of maxFrames JPEG frames, one every
            frameDelayMs, each sent to the client as it is written. Only in a web request whose response can go out while it
            is written: the servlet script/GenicamStreamServlet.js (README.md, Live MJPEG). It needs an authenticated user
            with permission on this service.</description>
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="connectionName"/>
            <parameter name="maxFrames" type="Integer"/>
            <parameter name="frameDelayMs" type="Long"/>
        </in-parameters>
        <out-parameters>
            <parameter name="sentFrames" type="Integer"/>
        </out-parameters>
        <actions>
            <if condition="!ec.web"><return error="true" message="This service must be called in a web request context."/></if>
            <entity-find-one entity-name="moqui.device.Device" value-field="device"/>
            <if condition="!device"><return error="true" message="Device not found: ${deviceId}"/></if>
            <if condition="connectionName">
                <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection">
                    <field-map field-name="connectionName"/>
                </entity-find-one>
                <else>
                    <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection">
                        <field-map field-name="deviceId"/>
                    </entity-find-one>
                </else>
            </if>
            <if condition="!connection"><return error="true" message="Connection not found for device: ${deviceId}"/></if>
            <if condition="!connection.transportConfig">
                <return error="true" message="Connection transportConfig must specify driver path."/>
            </if>
            <set field="genicam" from="ec.resource.script('component://moqui-genicam/service/moqui/genicam/Genicam.js')"/>
            <set field="answer" from="genicam.execute('liveMjpeg', context)"/>
            <set field="sentFrames" from="answer.sentFrames"/>
        </actions>
    </service>

    <service verb="acquire" noun="GenICam3DFrame" authenticate="false" transaction="ignore">
        <description>Captures a GenDC 3D (Time-of-Flight) frame and stores it as a moqui.math Tensor: Tensor, one
            TensorAxis per dimension and the NPY file as TensorContent.</description>
        <in-parameters>
            <parameter name="deviceId" required="true"/>
            <parameter name="connectionName"/>
            <parameter name="outputDir"/>
        </in-parameters>
        <out-parameters>
            <parameter name="tensorId"/>
            <parameter name="tensorContentId"/>
            <parameter name="contentLocation"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.device.Device" value-field="device"/>
            <if condition="!device"><return error="true" message="Device not found with ID: ${deviceId}"/></if>
            <if condition="connectionName">
                <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection">
                    <field-map field-name="connectionName"/>
                </entity-find-one>
                <else>
                    <entity-find-one entity-name="moqui.device.DeviceConnection" value-field="connection">
                        <field-map field-name="deviceId"/>
                    </entity-find-one>
                </else>
            </if>
            <if condition="!connection"><return error="true" message="Connection not found for device: ${deviceId}"/></if>
            <if condition="!connection.transportConfig">
                <return error="true" message="Connection transportConfig must specify driver path."/>
            </if>
            <set field="genicam" from="ec.resource.script('component://moqui-genicam/service/moqui/genicam/Genicam.js')"/>
            <set field="answer" from="genicam.execute('acquire3dFrame', context)"/>
            <set field="tensorId" from="answer.tensorId"/>
            <set field="tensorContentId" from="answer.tensorContentId"/>
            <set field="contentLocation" from="answer.contentLocation"/>
        </actions>
    </service>

    <!-- ========== Tensor Retention ========== -->

    <service verb="clean" noun="GenICamTensors" authenticate="false" transaction="ignore">
        <description>Deletes the 3D frames of acquire#GenICam3DFrame older than daysToKeep: the NPY file, then its
            TensorContent, TensorAxis and Tensor (delete#GenICamTensor, a transaction for each). Tensors of other
            components and files outside genicam.tensors.path are kept. Run daily by the job clean_GenICamTensors_daily.</description>
        <in-parameters>
            <parameter name="daysToKeep" type="Integer" default-value="30"/>
            <parameter name="outputDir"><description>The tensor directory, when not genicam.tensors.path.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="deletedCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="genicam" from="ec.resource.script('component://moqui-genicam/service/moqui/genicam/Genicam.js')"/>
            <set field="answer" from="genicam.execute('cleanTensors', context)"/>
            <set field="deletedCount" from="answer.deletedCount"/>
        </actions>
    </service>

    <service verb="delete" noun="GenICamTensor" authenticate="false">
        <in-parameters>
            <parameter name="tensorId" required="true"/>
        </in-parameters>
        <actions>
            <entity-delete-by-condition entity-name="moqui.math.TensorContent">
                <econdition field-name="tensorId"/>
            </entity-delete-by-condition>
            <entity-delete-by-condition entity-name="moqui.math.TensorAxis">
                <econdition field-name="tensorId"/>
            </entity-delete-by-condition>
            <entity-delete-by-condition entity-name="moqui.math.Tensor">
                <econdition field-name="tensorId"/>
            </entity-delete-by-condition>
        </actions>
    </service>
</services>
